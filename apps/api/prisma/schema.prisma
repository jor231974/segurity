  @@index([guardId])
  @@map("inventory_assignments")
}

// ============ PRE-NÓMINA (BLOQUE 19) ============

model PrePayroll {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId String?  @db.Uuid
  contract  Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  periodStart DateTime
  periodEnd   DateTime
  status      String   @default("borrador") // borrador, calculada, revisada, aprobada, exportada
  generatedById String @db.Uuid
  generatedBy  User     @relation(fields: [generatedById], references: [id], onDelete: Restrict)
  totalAmount  Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines        PrePayrollLine[]

  @@index([companyId])
  @@index([periodStart, periodEnd])
  @@map("pre_payrolls")
}

model PrePayrollLine {
  id          String     @id @default(uuid()) @db.Uuid
  prepayrollId String    @db.Uuid
  prepayroll   PrePayroll @relation(fields: [prepayrollId], references: [id], onDelete: Cascade)
  guardId     String     @db.Uuid
  guard       Guard      @relation(fields: [guardId], references: [id], onDelete: Cascade)
  serviceId   String?    @db.Uuid
  service     ContractService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  shiftId     String?    @db.Uuid
  shift       Shift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  workDays    Int        @default(0)
  workHours   Float      @default(0)
  overtimeHours Float     @default(0)
  absences    Int        @default(0)
  lateMinutes Int        @default(0)
  baseAmount  Decimal    @default(0) @db.Decimal(12, 2)
  overtimeAmount Decimal  @default(0) @db.Decimal(12, 2)
  bonusAmount Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal    @default(0) @db.Decimal(12, 2)

  @@index([prepayrollId])
  @@index([guardId])
  @@map("pre_payroll_lines")
}

// ============ FACTURACIÓN Y COBRANZA (BLOQUE 20) ============

model Invoice {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId String    @db.Uuid
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceId  String?   @db.Uuid
  service    ContractService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  clientId   String?   @db.Uuid
  clientInline Client? @relation("InvoiceClient", fields: [clientId], references: [id], onDelete: SetNull)
  number     String
  periodStart DateTime
  periodEnd   DateTime
  dueDate     DateTime
  amount      Decimal   @db.Decimal(12, 2)
  paidAmount  Decimal   @default(0) @db.Decimal(12, 2)
  status      String    @default("pendiente") // pendiente, parcialmente_pagada, pagada, vencida
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments    Payment[]

  @@index([companyId])
  @@index([contractId])
  @@unique([companyId, number])
  @@map("invoices")
}

model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @db.Uuid
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  method    String   @default("transferencia") // transferencia, cheque, efectivo, tarjeta, otro
  reference String?
  paymentDate DateTime @default(now())
  receivedById String? @db.Uuid
  receivedBy User?    @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("payments")
}

// ============ SOLICITUDES DEL CLIENTE (BLOQUE 21) ============

model ClientRequest {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId   String    @db.Uuid
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedById String  @db.Uuid
  requestedBy User     @relation("ClientRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  type       String
  priority   String    @default("media") // baja, media, alta, critica
  description String
  status     String    @default("abierta") // abierta, en_proceso, resuelta, cerrada
  assignedToId String? @db.Uuid
  assignedTo User?     @relation("ClientRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  response   String?
  completedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@map("client_requests")
}

// ============ NOTIFICACIONES (BLOQUE 22) ============

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String?   @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ============ REPORTES GUARDADOS (BLOQUE 23) ============

model Report {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  type      String
  filters   Json?
  generatedById String @db.Uuid
  generatedBy User   @relation(fields: [generatedById], references: [id], onDelete: Restrict)
  fileUrl   String?
  createdAt DateTime  @default(now())

  @@index([companyId])
  @@map("reports")
}

// ============ AUDITORÍA (BLOQUE 24) ============

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip         String?
  device     String?
  module     String
  action     String
  entity     String?
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}