// ============ EQUIPO / INVENTARIO (BLOQUE 18) ============

model InventoryItem {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        String   // radio, uniforme, chaleco, lámpara, detector, celular, cámara, otro
  serialNumber String
  brand       String?
  status      String   @default("disponible") // disponible, asignado, en_mantenimiento, baja
